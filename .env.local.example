# .env.local — git 미추적 (.gitignore의 *.local 규칙 적용)
# 이 파일을 복사해서 .env.local 로 이름 변경 후 실제 값 입력

# Supabase 프로젝트 설정 (https://supabase.com/dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://{project-ref}.supabase.co
VITE_SUPABASE_ANON_KEY={anon-public-key}

# Vercel 대시보드에만 등록 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY={service-role-key}
OPENAI_API_KEY={openai-key}
RESEND_API_KEY={resend-key}
TOSS_PAYMENTS_SECRET_KEY={tosspayments-secret}
