# =============================================================
# .env.example — 커밋 대상 (안전한 로컬 기본값 템플릿)
# 실제 값은 .env (gitignore)에 작성한다. connection URL은 절대 커밋 금지.
# =============================================================

# ── DB (Prisma) ──
# 로컬: Supabase CLI `supabase start` 기본값
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# ── App URL ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 이메일 알림 (Web3Forms) — 클라이언트 노출용 ──
NEXT_PUBLIC_LEAD_NOTIFY_KEY="fbce603b-441c-4b51-941b-f41b07733177"

# ── (선택) 코칭 AI 분석용 Anthropic 키 — 없으면 로컬 Mock 분석기 동작 ──
NEXT_PUBLIC_ANTHROPIC_API_KEY=""

# ── 관리자 인증 (MVP) — 실제 값은 .env / Vercel 에만, 절대 커밋 금지 ──
# SESSION_SECRET: 세션 쿠키 서명용 무작위 비밀키(서버 전용).
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# ADMIN_PASSWORD_HASH: 관리자 비밀번호의 scrypt 해시 ("salt:hash"). 평문 저장 금지.
#   생성: node scripts/hash-password.mjs "원하는비밀번호"
ADMIN_PASSWORD_HASH=""
